# Redis (queue state store).
#
# Production: install the Upstash integration from the Vercel Marketplace on
# this project - it provisions these two values automatically as project env
# vars, no manual copy/paste needed.
#
# Local dev / tests: point these at the local serverless-redis-http proxy
# started by `docker compose -f docker-compose.test.yml up -d` (see .env.test
# for the exact local values already wired into the integration test suite).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Web Push (queue-notifications feature).
#
# Generate a key pair once with `npx web-push generate-vapid-keys` - it
# prints a Public Key and a Private Key. VAPID_PUBLIC_KEY and
# NEXT_PUBLIC_VAPID_PUBLIC_KEY must be set to the SAME value (the server
# signs push messages with the private key; the browser bundle reads the
# NEXT_PUBLIC_ copy of the public key to create the subscription) - the
# plain VAPID_PUBLIC_KEY copy is what the server passes to
# webpush.setVapidDetails alongside the private key.
VAPID_PUBLIC_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# VAPID_SUBJECT identifies who's sending the push, per RFC 8292 - it must be
# an https: or mailto: URI the deployer controls (e.g. mailto:you@example.com
# or https://your-deployed-domain.example), not a placeholder value.
VAPID_SUBJECT=

# Queue timing (all in seconds). Read at server start, so changing them only
# needs a redeploy/restart - no rebuild. Each falls back to the default shown
# below if unset or invalid.
#
# Time a person has to confirm they're ready once it's their turn, before
# they're skipped and the next person is promoted.
QUEUE_CONFIRM_WINDOW_SECONDS=60
# Nominal microwave heating time.
QUEUE_HEATING_NOMINAL_SECONDS=300
# Extra grace window after the nominal heating time before auto-ending the
# turn; also the "urgent" countdown threshold shown in the UI.
QUEUE_HEATING_URGENCY_SECONDS=30
# Estimated wait added per person ahead in the queue, for ETA display.
QUEUE_PER_PERSON_WAIT_SECONDS=300

# Idle-standby threshold (seconds), read client-side. A visitor outside the
# queue (Landing screen) with no qualifying activity for this long stops
# polling and is shown the Standby screen instead. Unlike the QUEUE_* vars
# above, this is inlined into the client bundle at BUILD time (Next.js's
# NEXT_PUBLIC_ handling), so changing it needs a rebuild, not just a
# redeploy/restart.
NEXT_PUBLIC_QUEUE_IDLE_TIMEOUT_SECONDS=180

# Sentry (error monitoring/tracing). Same DSN value for both - it identifies
# the Sentry project, it isn't a secret, so there's no harm in it also being
# visible in the client bundle.
#
# SENTRY_DSN is read by sentry.server.config.ts / sentry.edge.config.ts at
# request time - changing it only needs a redeploy/restart.
# NEXT_PUBLIC_SENTRY_DSN is read by instrumentation-client.ts and, like
# NEXT_PUBLIC_QUEUE_IDLE_TIMEOUT_SECONDS above, gets inlined into the client
# bundle at BUILD time - changing it needs a rebuild.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
