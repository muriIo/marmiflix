# Redis (queue state store).
#
# Production: install the Upstash integration from the Vercel Marketplace on
# this project - it provisions these two values automatically as project env
# vars, no manual copy/paste needed.
#
# Local dev / tests: point these at the local serverless-redis-http proxy
# started by `docker compose -f docker-compose.test.yml up -d` (see .env.test
# for the exact local values already wired into the integration test suite).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
